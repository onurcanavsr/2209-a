# ---- Supabase (Project Settings > API) ----
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=
# Yalnızca SUNUCUDA kullanılır, asla arayüze/GitHub'a konmaz
SUPABASE_SERVICE_ROLE_KEY=
# Eski (HS256) projeler için. Yeni projelerde boş bırakın, JWKS kullanılır
SUPABASE_JWT_SECRET=

# ---- Yapay zeka ----
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=

# ---- Altyapı ----
REDIS_URL=redis://redis:6379/0
CORS_ORIGINS=http://localhost:3000
MAX_UPLOAD_MB=10
DAILY_LIMIT_PER_USER=20
DAILY_SUMMARY_LIMIT=30
DAILY_QA_LIMIT=60
DAILY_QUIZ_LIMIT=15
DAILY_CARD_LIMIT=10
# YouTube transkripti: sunucu IP'si engellenirse bir HTTP proxy adresi verin (boş = doğrudan bağlan)
YOUTUBE_PROXY_URL=
# Yönetim paneli maliyet TAHMİNİ (USD / milyon token). Modeli değiştirirseniz güncelleyin; gerçek fiyatlar için
# platform.claude.com/docs/en/about-claude/pricing sayfasına bakın.
COST_LLM_MAIN_IN_PER_MTOK=2.0
COST_LLM_MAIN_OUT_PER_MTOK=10.0
COST_LLM_FAST_IN_PER_MTOK=1.0
COST_LLM_FAST_OUT_PER_MTOK=5.0
COST_TTS_PER_MCHAR=15.0
# Seslendirme sesleri: Türkçe için TTS_VOICE, İngilizce için TTS_VOICE_EN (isteğe bağlı)
# TTS_VOICE=tr-TR-EmelNeural
# TTS_VOICE_EN=en-US-AriaNeural
COST_CHARS_PER_TOKEN=3.0


# ---- Sesli komut (STT) ----
STT_PROVIDER=openai
OPENAI_API_KEY=
STT_MODEL=gpt-transcribe
DAILY_STT_REQUESTS=300
COST_STT_PER_MIN=0.0045
# Bir belgeden alınacak en çok karakter (varsayılan 400000 ≈ 130-140 sayfa). Daha uzun belgeler kısaltılır: sayfa gezintisi, özet ve soru-cevap yalnızca alınan kısmı görür.
# Daha uzun belgeler için artırın (örn. 200 sayfa ≈ 600000, 300 sayfa ≈ 900000). Özet uzun belgede daha fazla ucuz model çağrısı yapar (40.000 karakter başına bir çağrı).
# MAX_TEXT_CHARS=1000000
# Belgedeki görsellerden (resim/fotoğraf/ekran görüntüsü) OCR ile okunacak en çok görsel (varsayılan 40) ve bunlar için toplam süre bütçesi (sn). Artırırsanız yükleme süresi uzar.
# OCR_MAX_IMAGES=40
# OCR_IMAGES_SECONDS=240
